# Relayn Configuration Example
# Copy this file to .env and adjust variables as needed

# Application & Network
RELAYN_ENV=development
RELAYN_PORT=8000
RELAYN_HOST=127.0.0.1
RELAYN_APP_URL=http://localhost:3000

# Security (Passphrase & Session)
# Local master password hash (Argon2id format)
RELAYN_PASSWORD_HASH=
# 32-byte hex-encoded key for AES-GCM session cookie encryption
RELAYN_SESSION_SECRET=

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/relayn

# Owner Preferences
RELAYN_TIMEZONE=UTC

# AI Provider (Gemini / Fixtures)
AI_PROVIDER=fixtures
GEMINI_API_KEY=

# Google OAuth (Gmail API - Phase 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
